/* Hangar shop (UI/art pass, Pass 7a). Cards, header and tabs come from Theme/Theme.uss; this file lays out the coin chip,
   the plane grid and the Beta banner. Flow layout inside the menu's safe-area padding. */

.shop-screen {
    flex-grow: 1;
    padding: 16px 24px 24px 24px;
}

/* ---- Coin chip (header, right) ---- */

.shop-coin-chip { flex-shrink: 0; margin-right: 8px; }

.shop-coin-chip > .lipbox__lip {
    top: 8px;
    border-radius: 20px;
    background-color: rgba(16, 24, 35, 0.6);
}

.shop-coin-chip { padding-bottom: 8px; }

.shop-coin-chip > .lipbox__face {
    padding: 16px 30px;
    border-width: 4px;
    border-radius: 20px;
    border-color: rgba(240, 169, 59, 0.5);
    background-color: rgba(240, 169, 59, 0.16);
}

.shop-coin {
    width: 30px;
    height: 30px;
    margin-left: 10px;
    border-radius: 15px;
    flex-shrink: 0;
    background-color: var(--amber);
    background-image: url("../Art/Textures/UI/Tex_UiGradAmber.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.shop-coin--chip {
    width: 44px;
    height: 44px;
    margin-left: 0;
    margin-right: 16px;
    border-radius: 22px;
}

.shop-coin-value {
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 46px;
    color: var(--amber);
}

/* ---- Tabs ---- */

.shop-tabs {
    align-self: flex-start;
    flex-shrink: 0;
    margin-top: 10px;
    border-radius: 22px;
    background-color: rgba(16, 24, 35, 0.5);
}

.shop-tabs .tabbar__tab { padding: 14px 40px; border-radius: 16px; }

.shop-tabs .tabbar__label { font-size: 32px; letter-spacing: 2px; }

/* ---- Body: plane grid or Beta banner ---- */

.shop-body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 24px;
}

.shop-grid {
    flex-direction: row;
    flex-shrink: 0;
}

.shop-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 26px;
}

.shop-card--first { margin-left: 0; }

.shop-card.card > .lipbox__face { padding: 24px; }

.shop-card--equipped.card > .lipbox__face { border-color: var(--green); }

.shop-card--locked.card > .lipbox__face {
    background-color: var(--panel-inner);
    border-color: rgba(246, 239, 226, 0.3);
}

.shop-card--locked.card > .lipbox__lip { background-color: rgba(16, 24, 35, 0.5); }

/* The thumbnail slot stays empty and transparent for the 3D half (the plane render). */
.shop-thumb {
    height: 250px;
    flex-shrink: 0;
    border-width: 4px;
    border-radius: 18px;
    border-color: rgba(246, 239, 226, 0.4);
    background-color: rgba(246, 239, 226, 0.03);
    align-items: center;
    justify-content: center;
}

.shop-thumb--locked {
    border-width: 0;
    background-color: rgba(10, 16, 24, 0.5);
}

.shop-thumb__mark {
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 90px;
    color: rgba(246, 239, 226, 0.35);
}

.shop-name {
    height: 56px;
    margin-top: 12px;
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 38px;
    color: var(--ink);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.shop-name--locked { color: rgba(246, 239, 226, 0.6); }

.shop-desc {
    height: 36px;
    -unity-font-definition: url("../Art/Fonts/Nunito-SemiBold.ttf");
    font-size: 24px;
    color: rgba(246, 239, 226, 0.6);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---- Card action: BUY button / state pills (one fixed height so the four cards line up) ---- */

.shop-action {
    height: 88px;
    margin-top: 16px;
    flex-shrink: 0;
}

.shop-action__label {
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 30px;
    color: var(--ink-dark);
}

/* The coin on the amber BUY button is dark, like the mockup's glyph. */
.shop-action .shop-coin {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-image: none;
    background-color: var(--ink-dark);
}

.shop-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 78px;
    margin-top: 16px;
    margin-bottom: 10px;
    flex-shrink: 0;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgba(246, 239, 226, 0.2);
    background-color: var(--panel-inner);
}

.shop-pill__label {
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 26px;
    color: rgba(246, 239, 226, 0.55);
}

.shop-pill__label--tail { margin-left: 8px; }

.shop-pill--equipped {
    border-color: var(--green);
    background-color: rgba(95, 194, 106, 0.2);
}

.shop-pill__label--equipped {
    font-size: 30px;
    color: #BFF0C3;
}

.shop-pill--locked {
    border-width: 0;
    background-color: rgba(246, 239, 226, 0.08);
}

.shop-pill__label--locked { font-size: 28px; color: rgba(246, 239, 226, 0.5); }

/* ---- Beta banner (CRASH FX / BUILDING SKINS) ---- */

.shop-beta {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.shop-beta__tape {
    width: 880px;
    padding: 40px 0;
    align-items: center;
    rotate: -3deg;
    border-bottom-width: 14px;
    border-bottom-color: rgba(16, 24, 35, 0.5);
    background-color: var(--amber);
    background-image: url("../Art/Textures/UI/Tex_UiHazardTape.png");
    background-repeat: repeat repeat;
    background-size: 108px 108px;
    background-position: left top;
}

.shop-beta__plate {
    padding: 24px 54px;
    border-radius: 16px;
    background-color: #1B2330;
    align-items: center;
}

.shop-beta__title {
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 76px;
    color: var(--amber);
    white-space: nowrap;
}

.shop-beta__body {
    -unity-font-definition: url("../Art/Fonts/Nunito-SemiBold.ttf");
    font-size: 28px;
    color: rgba(246, 239, 226, 0.75);
    white-space: nowrap;
}

/* ---- Footnote ---- */

.shop-footnote {
    flex-shrink: 0;
    margin-top: 12px;
    white-space: normal;
    -unity-font-definition: url("../Art/Fonts/Nunito-SemiBold.ttf");
    font-size: 28px;
    color: rgba(246, 239, 226, 0.6);
}
