<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:op="Opoint8182.UI">
    <Style src="project://database/Assets/_Project/UI/Theme/Theme.uss" />
    <Style src="GameOver.uss" />
    <!-- Game Over (UI/art pass, Pass 5, mockup S05). One full-panel backdrop that picks pointer events, so the frozen HUD
         underneath (shared runtime panel) cannot be touched while it shows. Content is centred and inset by the safe area. -->
    <ui:VisualElement name="game-over-root" class="theme go-root">
        <ui:VisualElement name="go-safe" class="go-safe" picking-mode="Ignore">
            <ui:VisualElement name="go-content" class="go-content" picking-mode="Ignore">

                <!-- Title + cause chip -->
                <ui:VisualElement class="go-head" picking-mode="Ignore">
                    <ui:Label name="go-title" text="GAME OVER" class="t-baloo-extrabold go-title" picking-mode="Ignore" />
                    <ui:VisualElement name="go-cause" class="go-cause" picking-mode="Ignore">
                        <ui:Label name="go-cause-label" text="OUT OF FUEL" class="t-nunito-extrabold go-cause-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Final score + NEW BEST sticker -->
                <ui:VisualElement class="go-score-row" picking-mode="Ignore">
                    <ui:VisualElement class="go-score-col" picking-mode="Ignore">
                        <ui:Label text="FINAL SCORE" class="t-nunito-extrabold go-score-caption" picking-mode="Ignore" />
                        <ui:Label name="go-score" text="0" class="t-baloo-extrabold go-score" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <op:LipBox name="go-new-best" class="go-new-best" picking-mode="Ignore">
                        <ui:Label text="NEW BEST!" class="t-baloo-extrabold go-new-best-label" picking-mode="Ignore" />
                    </op:LipBox>
                    <op:LipBox name="go-your-best" class="go-your-best" picking-mode="Ignore">
                        <ui:Label text="YOUR BEST" class="t-nunito-extrabold go-best-caption" picking-mode="Ignore" />
                        <ui:Label name="go-best-value" text="" class="t-baloo-extrabold go-best-value" picking-mode="Ignore" />
                    </op:LipBox>
                </ui:VisualElement>

                <!-- Stat chips -->
                <ui:VisualElement class="go-stats-row" picking-mode="Ignore">
                    <op:LipBox class="go-stat" picking-mode="Ignore">
                        <ui:Label text="DISTANCE" class="t-nunito-extrabold go-stat-caption" picking-mode="Ignore" />
                        <ui:Label name="go-stat-distance" text="" class="t-baloo-extrabold go-stat-value" picking-mode="Ignore" />
                    </op:LipBox>
                    <op:LipBox class="go-stat" picking-mode="Ignore">
                        <ui:Label text="FLATTENED" class="t-nunito-extrabold go-stat-caption" picking-mode="Ignore" />
                        <ui:Label name="go-stat-flattened" text="" class="t-baloo-extrabold go-stat-value" picking-mode="Ignore" />
                    </op:LipBox>
                    <op:LipBox class="go-stat" picking-mode="Ignore">
                        <ui:Label text="BEST COMBO" class="t-nunito-extrabold go-stat-caption" picking-mode="Ignore" />
                        <ui:Label name="go-stat-combo" text="" class="t-baloo-extrabold go-stat-value" picking-mode="Ignore" />
                    </op:LipBox>
                    <op:LipBox class="go-stat go-stat--earned" picking-mode="Ignore">
                        <ui:Label text="EARNED" class="t-nunito-extrabold go-stat-caption" picking-mode="Ignore" />
                        <ui:VisualElement class="go-earned-row" picking-mode="Ignore">
                            <ui:Label name="go-stat-earned" text="" class="t-baloo-extrabold go-stat-value" picking-mode="Ignore" />
                            <ui:VisualElement class="go-coin-dot" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </op:LipBox>
                </ui:VisualElement>

                <!-- Rank chip (S05 step 3): one chip, several states set by GameOverView (RANKING skeleton, ranked + arrow image,
                     unranked + gap, failed + retry, unavailable). Neutral "RANK" copy until the leaderboard rework (backlog #28).
                     Only the arrow is an image (Tex_UiArrowUp, tinted in USS) so no glyph needs a font fallback. -->
                <op:LipBox name="go-rank-chip" class="go-rank-chip">
                    <!-- lead / tail are clipped containers whose max-width GameOverView grows after the rank number has counted
                         down, so the chip starts as just the number and widens to fit the caption, arrow and status. -->
                    <ui:VisualElement name="go-rank-lead" class="go-rank-lead" picking-mode="Ignore">
                        <ui:Label name="go-rank-caption" text="RANK" class="t-nunito-extrabold go-rank-caption" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="go-rank-value" text="" class="t-baloo-extrabold go-rank-value" picking-mode="Ignore" />
                    <ui:VisualElement name="go-rank-tail" class="go-rank-tail" picking-mode="Ignore">
                        <ui:VisualElement name="go-rank-delta" class="go-rank-delta" picking-mode="Ignore">
                            <ui:VisualElement class="go-rank-arrow" picking-mode="Ignore" />
                            <ui:Label name="go-rank-delta-text" text="" class="t-baloo-extrabold go-rank-delta-text" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="go-rank-sep" class="go-rank-sep" picking-mode="Ignore" />
                        <ui:Label name="go-rank-status" text="" class="t-nunito-extrabold go-rank-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="go-rank-skeleton" class="go-rank-skeleton" picking-mode="Ignore">
                        <ui:VisualElement class="go-rank-bar go-rank-bar--a" picking-mode="Ignore" />
                        <ui:VisualElement class="go-rank-bar go-rank-bar--b" picking-mode="Ignore" />
                        <ui:VisualElement class="go-rank-bar go-rank-bar--c" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="go-rank-message" text="" class="t-baloo-extrabold go-rank-message" picking-mode="Ignore" />
                    <op:LipButton name="go-rank-retry" text="RETRY" variant="Secondary" lip-size="Small" class="go-rank-retry" />
                </op:LipBox>

                <!-- Button row: attempt-driven (S05 a / b / c / practice). GameOverView.ApplyAttemptState sets which button is
                     primary, its note, the two secondary buttons and the SHARE tag; the row rises in last in the cascade. -->
                <ui:VisualElement name="go-actions" class="go-actions" picking-mode="Ignore">
                    <ui:VisualElement class="go-primary-col" picking-mode="Ignore">
                        <op:LipButton name="go-primary" text="RETRY" variant="Primary" lip-size="Large" class="go-primary" />
                        <ui:Label name="go-primary-note" text="" class="t-nunito-bold go-primary-note" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <op:LipButton name="go-secondary-a" text="MAIN MENU" variant="Secondary" class="go-secondary" />
                    <op:LipButton name="go-secondary-b" text="LEADERBOARD" variant="Secondary" class="go-secondary" />
                    <ui:VisualElement class="go-share-col" picking-mode="Ignore">
                        <op:LipButton name="go-share" variant="Secondary" class="go-share">
                            <ui:VisualElement class="go-share-inner" picking-mode="Ignore">
                                <ui:VisualElement class="go-share-icon" picking-mode="Ignore" />
                                <ui:Label text="SHARE" class="t-nunito-extrabold go-share-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </op:LipButton>
                        <ui:Label name="go-share-tag" text="PRACTICE" class="t-nunito-extrabold go-share-tag" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="go-toast" class="go-toast" picking-mode="Ignore">
            <ui:Label name="go-toast-label" text="" class="go-toast-label" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
