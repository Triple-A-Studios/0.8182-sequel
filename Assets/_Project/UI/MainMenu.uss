/* Main menu layout (UI/art pass, Pass 3). Colours, fonts and the chip/button/popup/tab looks live in
   Theme/Theme.uss; this file only positions the S02 elements and tunes theme components for this screen. */

.menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* A flowing child of the padded safe-area (so the device inset applies to the clusters inside it: an absolute fill
   would measure from the border box and ignore the padding). The -24px margin takes back the 24px base padding, so
   the clusters keep their mockup offsets from the screen edge and a notch inset is added on top (Pass 8a). */
.menu-screen {
    flex-grow: 1;
    margin: -24px;
}

/* ---- Chips (LipBox height includes the lip: 114 = 104 face + 10 lip) ---- */

.menu-chip {
    height: 114px;
    margin-right: 18px;
}

.menu-chip .lipbox__face { padding: 0 26px; }

/* ---- Top-left cluster ---- */

.top-left-cluster {
    position: absolute;
    left: 48px;
    top: 40px;
    flex-direction: row;
}

.menu-profile-chip .lipbox__face { padding: 0 30px 0 14px; }

.menu-avatar {
    width: 56px;
    height: 56px;
    margin-right: 16px;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: var(--panel-inner);
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
}

.menu-avatar__head {
    width: 20px;
    height: 20px;
    margin-bottom: 2px;
    border-radius: 10px;
    background-color: var(--ink);
}

.menu-avatar__body {
    width: 36px;
    height: 15px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    background-color: var(--ink);
}

.menu-profile-text { flex-direction: column; }

.menu-profile-name {
    font-size: 28px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

/* The one 19px exception to the 24px minimum (mockup spec). */
.menu-profile-sub {
    font-size: 19px;
    letter-spacing: 2px;
    color: var(--ink-55);
}

.menu-status-chip .lipbox__face { padding: 0 30px; }

.menu-status-group {
    flex-direction: row;
    align-items: center;
}

.menu-status-label { margin-right: 16px; }
.menu-status-pips { margin-right: 8px; }

/* ---- Top-right cluster ---- */

.top-right-cluster {
    position: absolute;
    right: 48px;
    top: 40px;
    flex-direction: row;
    align-items: flex-start;
}

.menu-currency-chip .lipbox__face { padding: 0 26px; }

.menu-coin {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    border-radius: 20px;
    background-color: var(--amber);
    background-image: url("../Art/Textures/UI/Tex_UiGradAmber.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.menu-currency-value {
    font-size: 38px;
    color: var(--ink);
}

.menu-hamburger {
    width: 114px;
    margin-right: 0;
}

.menu-hamburger .lipbox__face {
    flex-direction: column;
    padding: 0;
}

.menu-bar {
    width: 48px;
    height: 7px;
    margin: 4px 0;
    border-radius: 4px;
    background-color: var(--ink);
}

/* ---- Logo block ---- */

.logo-block {
    position: absolute;
    left: 0;
    right: 0;
    top: 180px;
    align-items: center;
    rotate: -3deg;
}

.menu-logo-label {
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.menu-logo-shadow-back {
    position: absolute;
    color: var(--panel-lip);
    translate: 0 28px;
}

.menu-logo-shadow-mid {
    position: absolute;
    color: var(--coral);
    translate: 0 10px;
}

.menu-logo-front { color: var(--ink); }

.menu-tagline {
    margin-top: 16px;
    padding: 6px 26px;
    border-radius: 12px;
    background-color: var(--coral);
}

.menu-tagline-label {
    font-size: 32px;
    letter-spacing: 7px;
    color: rgb(255, 255, 255);
}

/* ---- Left icon column ---- */

.left-icon-column {
    position: absolute;
    left: 52px;
    top: 38%;
    flex-direction: column;
}

.menu-tile {
    width: 222px;
    height: 216px;
    margin-bottom: 26px;
}

.menu-tile .lipbox__face {
    flex-direction: column;
    border-radius: var(--radius-chip);
}

.menu-tile-label {
    font-size: 30px;
    letter-spacing: 2px;
    color: var(--ink);
}

.menu-tile-label--small { font-size: 26px; }

.menu-shop-icon {
    width: 86px;
    height: 58px;
    margin-bottom: 14px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: var(--amber);
}

.menu-lb-bars {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 14px;
}

.menu-lb-bar {
    width: 20px;
    margin-right: 7px;
    border-radius: 5px;
    background-color: var(--ink-70);
}

.menu-lb-bar--short { height: 32px; }
.menu-lb-bar--tall { height: 58px; background-color: var(--amber); }
.menu-lb-bar--mid { height: 44px; }

/* ---- Centre 3D slot (flex-centred; was a fixed-width auto-margin that did not centre) ---- */

.plane-slot-block {
    position: absolute;
    left: 0;
    right: 0;
    top: 556px;
    align-items: center;
}

.plane-slot {
    width: 660px;
    height: 230px;
    border-width: 4px;
    border-radius: 22px;
    border-color: rgba(246, 239, 226, 0.4);
    background-color: rgba(246, 239, 226, 0.06);
}

.plane-slot-caption {
    margin-top: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* DELETE before shipping - dev annotation for the 3D half, per mockup spec. */
.caption-label {
    font-size: 24px;
    color: var(--ink-55);
}

/* ---- Bottom-right PLAY cluster ---- */

.play-cluster {
    position: absolute;
    right: 56px;
    bottom: 44px;
    align-items: flex-end;
}

/* TabBar bent into mockup tabs that sit behind the PLAY button: no pill background, top-rounded tabs. */
.menu-mode-tabs {
    padding: 0 14px 0 0;
    border-width: 0;
    background-color: transparent;
}

.menu-mode-tabs .tabbar__tab {
    margin-left: 6px;
    padding: 16px 34px 32px 34px;
    border-radius: 0;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    background-color: rgba(16, 24, 35, 0.55);
}

.menu-mode-tabs .tabbar__label {
    font-size: 30px;
    letter-spacing: 3px;
}

.menu-mode-tabs .tabbar__tab--active { background-color: var(--coral); }

.menu-mode-tabs .tabbar__tab--active .tabbar__label {
    font-size: 32px;
    color: rgb(255, 255, 255);
}

.menu-play {
    min-width: 600px;
    margin-top: -26px;
}

.menu-play .lipbox__face {
    flex-direction: column;
    border-radius: 30px;
    padding: 24px 66px 28px 66px;
}

.menu-play-label {
    font-size: 118px;
    letter-spacing: 3px;
    color: var(--ink-dark);
    -unity-text-align: middle-center;
}

.menu-play-sub {
    flex-direction: row;
    align-items: center;
    margin-top: -10px;
}

.menu-play-sublabel {
    font-size: 28px;
    letter-spacing: 2px;
    color: rgba(42, 26, 6, 0.78);
    margin-right: 12px;
}

.menu-play-pips { flex-direction: row; }

.menu-play-pips .pip {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    border-radius: 8px;
    background-color: var(--ink-dark);
}

/* ---- Popups ---- */

.menu-popup-attempt { width: 1020px; }
.menu-popup-quit { width: 900px; }

.menu-attempt-row {
    flex-direction: row;
    align-items: center;
    margin-top: 24px;
}

.menu-attempt-row .pip {
    width: 26px;
    height: 26px;
    margin-right: 14px;
    border-radius: 13px;
}

.menu-attempt-link {
    font-size: 26px;
    margin-left: 6px;
    color: var(--ink-70);
}

.menu-attempt-actions { margin-top: 32px; }

.menu-popup-primary {
    width: 520px;
    height: 124px;
    margin-right: 24px;
}

.menu-popup-secondary {
    width: 320px;
    height: 124px;
}

.menu-dont-ask {
    flex-direction: row;
    align-items: center;
    margin-top: 32px;
}

.menu-dont-ask-label {
    font-size: 26px;
    margin-left: 16px;
}

/* Overflow dropdown: absolutely placed under the hamburger inside the popup layer. */
.menu-popup-overflow {
    position: absolute;
    right: 72px;
    top: 168px;
    width: 460px;
    padding-bottom: 12px;
}

.menu-popup-overflow > .lipbox__lip {
    top: 12px;
    border-radius: 24px;
}

.menu-popup-overflow > .lipbox__face {
    padding: 26px;
    border-radius: 24px;
}

.menu-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    padding: 20px 24px;
    border-radius: 16px;
    background-color: var(--panel-inner);
    transition-property: scale;
    transition-duration: 0.08s;
}


.menu-row.is-pressed { scale: 0.97 0.97; }

.menu-row__icon {
    width: 32px;
    height: 32px;
    margin-right: 18px;
    border-radius: 16px;
    border-width: 7px;
    border-color: var(--ink);
}

.menu-row__label {
    font-size: 32px;
    letter-spacing: 2px;
    color: var(--ink);
}

.menu-row--danger {
    border-width: 3px;
    border-color: rgba(232, 96, 60, 0.6);
    background-color: rgba(232, 96, 60, 0.2);
}

.menu-row--danger .menu-row__label { color: var(--danger-text); }
