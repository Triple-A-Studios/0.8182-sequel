.score-label {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 4px 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.combo-label {
    position: absolute;
    top: 56px;
    right: 20px;
    padding: 2px 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(255, 200, 0);
    color: rgb(255, 200, 0);
    font-size: 16px;
    -unity-font-style: bold;
}

.combo-timer-background {
    position: absolute;
    top: 88px;
    right: 20px;
    width: 140px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgb(255, 200, 0);
}

.combo-timer-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 200, 0);
}
