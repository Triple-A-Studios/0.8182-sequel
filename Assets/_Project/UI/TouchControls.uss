/* Touch-capture area for the floating joystick - left half of the panel for now
   (hardcoded; a later pass makes this a developer-facing side setting). Invisible,
   just where PointerDown events are registered. */
.touch-joystick-zone {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
}

.touch-joystick-background {
    /* Repositioned via inline style.left/top on every touch-down - floats to
       wherever the player touches within touch-joystick-zone instead of sitting at
       a fixed rest position. Hidden until touched. */
    display: none;
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 70px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    align-items: center;
    justify-content: center;
}

.touch-joystick-handle {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.5);
}

.touch-boost-button {
    position: absolute;
    right: 40px;
    bottom: 40px;
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(255, 140, 0, 0.35);
    border-width: 2px;
    border-color: rgba(255, 140, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.touch-boost-label {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}
