.touch-joystick-background {
    position: absolute;
    left: 40px;
    bottom: 40px;
    width: 140px;
    height: 140px;
    border-radius: 70px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    align-items: center;
    justify-content: center;
}

.touch-joystick-handle {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.5);
}

.touch-boost-button {
    position: absolute;
    right: 40px;
    bottom: 40px;
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(255, 140, 0, 0.35);
    border-width: 2px;
    border-color: rgba(255, 140, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.touch-boost-label {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}
