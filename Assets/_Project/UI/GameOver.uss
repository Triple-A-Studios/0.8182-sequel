.game-over-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.7);
}

.game-over-title {
    padding: 6px 24px;
    margin-bottom: 16px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 48px;
    -unity-font-style: bold;
}

.game-over-score-label {
    padding: 4px 10px;
    margin-bottom: 24px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
}

.restart-button {
    padding: 8px 24px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}
