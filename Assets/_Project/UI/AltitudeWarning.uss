.altitude-warning-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    align-items: center;
}

.altitude-warning-label {
    padding: 4px 16px;
    margin-bottom: 8px;
    background-color: rgba(120, 0, 0, 0.6);
    border-width: 2px;
    border-color: rgb(255, 60, 60);
    color: rgb(255, 60, 60);
    font-size: 22px;
    -unity-font-style: bold;
}

.altitude-warning-background {
    width: 240px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgb(255, 60, 60);
}

.altitude-warning-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 60, 60);
}
