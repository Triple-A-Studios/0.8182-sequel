<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:op="Opoint8182.UI">
    <Style src="project://database/Assets/_Project/UI/Theme/Theme.uss" />
    <Style src="Hud.uss" />
    <!-- One merged HUD panel (UI/art pass, Pass 4). Everything ignores pointer events except the pause button, the boost
         button and the joystick zone, so nothing else in the panel blocks input. -->
    <ui:VisualElement name="hud-root" class="theme hud-root" picking-mode="Ignore">

        <!-- Input layer: full panel, NOT safe-area inset (the joystick math is in panel space). Sits below everything
             else; only the joystick zone picks pointer events, so the layers above stay click-through. -->
        <ui:VisualElement name="hud-input" class="hud-input" picking-mode="Ignore">
            <ui:VisualElement name="touch-joystick-zone" class="hud-joy-zone" />
            <ui:VisualElement name="touch-joystick-background" class="hud-joy-base" picking-mode="Ignore">
                <ui:VisualElement name="touch-joystick-handle" class="hud-joy-handle" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Safe-area layer: HudView applies SafeAreaHelper to this element; hud-content fills its padding box,
             so absolutely positioned HUD pieces are inset by the device safe area. -->
        <ui:VisualElement name="hud-safe" class="hud-safe" picking-mode="Ignore">
            <ui:VisualElement name="hud-content" class="hud-content" picking-mode="Ignore">

                <ui:VisualElement name="score-block" class="hud-score-block" picking-mode="Ignore">
                    <ui:Label text="SCORE" class="t-baloo-extrabold hud-score-label" picking-mode="Ignore" />
                    <ui:Label name="score-value" text="0" class="t-baloo-extrabold hud-score-value" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:Label name="practice-tag" text="PRACTICE" class="t-nunito-extrabold hud-practice-tag" picking-mode="Ignore" />

                <ui:VisualElement name="top-stack" class="hud-top-stack" picking-mode="Ignore">
                    <ui:VisualElement name="fuel-cluster" class="hud-fuel-cluster" picking-mode="Ignore">
                        <ui:VisualElement name="fuel-glow" class="hud-glow hud-fuel-glow" picking-mode="Ignore" />
                        <ui:VisualElement name="fuel-pips" class="hud-fuel-pips" picking-mode="Ignore" />
                        <ui:Label name="fuel-label" text="FUEL" class="t-baloo-extrabold hud-fuel-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="health-wrap" class="hud-health-wrap" picking-mode="Ignore">
                        <ui:VisualElement name="health-glow" class="hud-glow hud-health-glow" picking-mode="Ignore" />
                        <ui:VisualElement name="health-bar" class="hud-health-bar" picking-mode="Ignore">
                            <ui:VisualElement name="health-fill" class="hud-health-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <op:LipButton name="pause-button" class="hud-pause-button" lip-size="Small">
                    <ui:VisualElement class="hud-pause-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-pause-bar" picking-mode="Ignore" />
                </op:LipButton>

                <op:LipBox name="touch-boost-button" variant="Primary" class="hud-boost">
                    <ui:Label text="BOOST" class="lipbox__label hud-boost-label" picking-mode="Ignore" />
                </op:LipBox>

                <ui:VisualElement name="hit-wrap" class="hud-hit-wrap" picking-mode="Ignore">
                    <op:LipBox name="hit-sticker" class="hud-hit-sticker" picking-mode="Ignore">
                        <ui:Label name="hit-label" text="-1 HEALTH" class="t-baloo-extrabold hud-hit-label" picking-mode="Ignore" />
                    </op:LipBox>
                </ui:VisualElement>

                <op:LipBox name="combo-sticker" class="hud-combo-sticker" picking-mode="Ignore">
                    <ui:Label name="combo-label" text="x3 COMBO!" class="t-baloo-extrabold hud-combo-label" picking-mode="Ignore" />
                </op:LipBox>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Full-frame effects (state g): above the content, click-through. -->
        <ui:VisualElement name="hud-fx" class="hud-fx" picking-mode="Ignore">
            <!-- Damage (state h): dark vignette + cracks; HudView suppresses it while the ground warning owns the frame. -->
            <ui:VisualElement name="damage-overlay" class="hud-damage-overlay" picking-mode="Ignore">
                <ui:VisualElement class="hud-damage-vignette" picking-mode="Ignore" />
                <ui:VisualElement class="hud-damage-cracks" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ground-vignette" class="hud-vignette-red" picking-mode="Ignore" />
            <ui:Label name="ground-text" text="PULL UP!" class="t-baloo-extrabold hud-ground-text" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Edge layer (full panel, not safe-area inset): taped banners that own the screen edges (states e, f). -->
        <ui:VisualElement name="hud-edge" class="hud-edge" picking-mode="Ignore">
            <ui:VisualElement name="ceiling-banner" class="hud-tape hud-ceiling-banner" picking-mode="Ignore">
                <ui:VisualElement class="hud-tape-plate hud-ceiling-plate" picking-mode="Ignore">
                    <ui:Label text="TOO HIGH &#8211; DESCEND!" class="t-baloo-extrabold hud-tape-text hud-ceiling-text" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-ceiling-count" picking-mode="Ignore">
                        <ui:Label name="ceiling-count" text="3" class="t-baloo-extrabold hud-ceiling-count-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="lateral-tape-left" class="hud-tape hud-lateral-tape hud-lateral-tape--left" picking-mode="Ignore">
                <ui:VisualElement class="hud-tape-plate hud-lateral-plate" picking-mode="Ignore">
                    <ui:Label text="TURN BACK" class="t-baloo-extrabold hud-tape-text hud-lateral-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="lateral-tape-right" class="hud-tape hud-lateral-tape hud-lateral-tape--right" picking-mode="Ignore">
                <ui:VisualElement class="hud-tape-plate hud-lateral-plate" picking-mode="Ignore">
                    <ui:Label text="TURN BACK" class="t-baloo-extrabold hud-tape-text hud-lateral-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Impact popups (state c): pooled labels HudImpactPopups adds here, full panel so positions are panel px. -->
        <ui:VisualElement name="hud-popups" class="hud-popups" picking-mode="Ignore" />


        <!-- Pause popup (S04) and the leave-run confirm: ScreenRouter popup layer, opened by HudPausePopup (from
             HudPresenter once GameManager has paused). -->
        <ui:VisualElement name="hud-popup-layer" class="popup-layer">
            <op:LipBox name="hud-pause-popup" class="popup hud-pause-card">
                <ui:VisualElement class="hud-pause-head" picking-mode="Ignore">
                    <ui:Label text="PAUSED" class="t-baloo-extrabold hud-pause-title" picking-mode="Ignore" />
                    <ui:Label name="pause-mode-line" text="" class="t-nunito-extrabold hud-pause-mode" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-pause-body">
                    <ui:VisualElement class="hud-pause-left">
                        <ui:VisualElement class="hud-pause-row" picking-mode="Ignore">
                            <ui:Label text="SOUND" class="t-nunito-extrabold hud-pause-row-label" picking-mode="Ignore" />
                            <ui:Label name="pause-sound-value" text="80" class="t-nunito-extrabold hud-pause-row-value" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <op:ThemedSlider name="pause-sound" low-value="0" high-value="100" value="80" />
                        <ui:VisualElement class="hud-pause-row hud-pause-row--second" picking-mode="Ignore">
                            <ui:Label text="SCREEN SHAKE" class="t-nunito-extrabold hud-pause-row-label" picking-mode="Ignore" />
                            <ui:Label name="pause-shake-value" text="120" class="t-nunito-extrabold hud-pause-row-value" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <op:ThemedSlider name="pause-shake" low-value="0" high-value="150" value="120" />
                        <ui:VisualElement class="hud-pause-switch-row">
                            <ui:Label text="HAPTICS" class="t-nunito-extrabold hud-pause-row-label" picking-mode="Ignore" />
                            <ui:Toggle name="pause-haptics" class="switch" />
                        </ui:VisualElement>
                        <ui:Label text="Full list lives in Settings." class="t-nunito-semibold hud-pause-hint" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-pause-right">
                        <op:LipButton name="pause-resume" text="RESUME" variant="Primary" class="hud-pause-resume" />
                        <op:LipButton name="pause-restart" text="RESTART RUN" variant="Secondary" class="hud-pause-secondary" />
                        <op:LipButton name="pause-quit" text="QUIT TO MENU" variant="Danger" class="hud-pause-secondary" />
                        <ui:Label name="pause-quit-note" text="" class="t-nunito-semibold hud-pause-quit-note" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </op:LipBox>

            <!-- Leave-run confirm (competitive runs only): QUIT TO MENU asks first, because the attempt is lost unscored. -->
            <op:LipBox name="hud-leave-popup" class="popup hud-leave-card">
                <ui:Label text="LEAVE THIS RUN?" class="popup__title" picking-mode="Ignore" />
                <ui:Label name="leave-body" text="You will lose this attempt without submitting your score." class="popup__body" picking-mode="Ignore" />
                <ui:VisualElement class="popup__actions hud-leave-actions">
                    <op:LipButton name="leave-yes" text="LEAVE RUN" variant="Danger" class="hud-leave-primary" />
                    <op:LipButton name="leave-no" text="BACK" variant="Secondary" class="hud-leave-secondary" />
                </ui:VisualElement>
            </op:LipBox>

            <!-- Restart confirm (competitive runs only): RESTART RUN gives this attempt up and uses the next one. -->
            <op:LipBox name="hud-restart-popup" class="popup hud-leave-card">
                <ui:Label text="RESTART THIS RUN?" class="popup__title" picking-mode="Ignore" />
                <ui:Label name="restart-body" text="" class="popup__body" picking-mode="Ignore" />
                <ui:VisualElement class="popup__actions hud-leave-actions">
                    <op:LipButton name="restart-yes" text="RESTART" variant="Danger" class="hud-leave-primary" />
                    <op:LipButton name="restart-no" text="BACK" variant="Secondary" class="hud-leave-secondary" />
                </ui:VisualElement>
            </op:LipBox>
        </ui:VisualElement>

        <!-- Portrait prompt: covers everything (popups included) while the screen is portrait during a run. HudPresenter
             pauses the run first; HudView.SetRotateGate shows this. -->
        <ui:VisualElement name="hud-rotate" class="hud-rotate">
            <ui:VisualElement class="hud-rotate__icon" picking-mode="Ignore" />
            <ui:Label text="ROTATE YOUR DEVICE" class="hud-rotate__title" picking-mode="Ignore" />
            <ui:Label text="Opoint8182 is played in landscape." class="hud-rotate__body" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 3-2-1 resume countdown (S04): dims the frame while it runs, so it blocks input like the popup. -->
        <ui:VisualElement name="hud-countdown" class="hud-countdown">
            <ui:Label name="hud-countdown-number" text="3" class="t-baloo-extrabold hud-countdown-number" picking-mode="Ignore" />
            <ui:Label text="GET READY" class="t-nunito-extrabold hud-countdown-text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
