/* Merged gameplay HUD layout (UI/art pass, Pass 4). Colours, fonts and shared components come from Theme/Theme.uss;
   this file positions the S03 pieces. Reference frame 2400x1080 (mockup S03). */

.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-input {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Touch-capture area for the floating joystick: left half of the panel (a later settings pass makes the side configurable). */
.hud-joy-zone {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 50%;
}

/* Repositioned to the touch point on every touch-down; hidden until touched. Size must match HudTouchControls.BaseSize. */
.hud-joy-base {
    display: none;
    position: absolute;
    width: 300px;
    height: 300px;
    border-width: 7px;
    border-radius: 150px;
    border-color: rgba(246, 239, 226, 0.3);
    background-color: rgba(10, 16, 24, 0.3);
    align-items: center;
    justify-content: center;
}

/* Handle size must match HudTouchControls.HandleMaxTravel: (300 - 132) / 2. */
.hud-joy-handle {
    width: 132px;
    height: 132px;
    border-radius: 66px;
    background-color: #EAE1D0;
}

.hud-safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Fills the safe-area padding box, so absolute children below are inset by the device safe area. */
.hud-content { flex-grow: 1; }

/* ---- Score (top left) ---- */

.hud-score-block {
    position: absolute;
    left: 44px;
    top: 24px;
    align-items: flex-start;
}

.hud-score-label {
    font-size: 28px;
    letter-spacing: 5px;
    margin-left: 5px;
    color: var(--ink-70);
}

.hud-score-value {
    font-size: 96px;
    margin-top: -22px;
    color: var(--ink);
    text-shadow: 0 7px 0 rgba(16, 24, 35, 0.75);
    white-space: nowrap;
}

.hud-practice-tag {
    position: absolute;
    left: 44px;
    top: 196px;
    padding: 9px 20px;
    border-width: 2px;
    border-radius: 12px;
    border-color: rgba(246, 239, 226, 0.22);
    background-color: rgba(10, 16, 24, 0.35);
    font-size: 24px;
    letter-spacing: 5px;
    color: var(--ink-70);
    white-space: nowrap;
}

/* ---- Top-centre stack: fuel pips + health bar ---- */

.hud-top-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 56px;
    align-items: center;
}

.hud-fuel-cluster { align-items: center; }

.hud-fuel-pips {
    flex-direction: row;
    padding: 9px;
    border-radius: 20px;
    background-color: rgba(10, 16, 24, 0.34);
}

.hud-pip {
    width: 46px;
    height: 40px;
    margin-right: 7px;
    border-radius: 7px;
    background-color: rgba(10, 16, 24, 0.55);
    overflow: hidden;
}

.hud-pip--last { margin-right: 0; }

.hud-pip__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-radius: 7px;
    border-bottom-width: 6px;
    border-bottom-color: rgba(0, 0, 0, 0.22);
    background-color: var(--amber);
}

.hud-fuel-label {
    margin-top: 6px;
    font-size: 24px;
    letter-spacing: 6px;
    color: var(--ink-70);
}

.hud-health-wrap { margin-top: 14px; }

.hud-health-bar {
    width: 520px;
    height: 26px;
    border-radius: 13px;
    background-color: rgba(10, 16, 24, 0.45);
    overflow: hidden;
}

.hud-health-fill {
    width: 100%;
    height: 100%;
    border-radius: 13px;
    background-color: var(--green);
}

/* ---- Pause button (top right). Height includes the small lip: 110 = 104 face + 6 lip. ---- */

.hud-pause-button {
    position: absolute;
    right: 56px;
    top: 48px;
    width: 104px;
    height: 110px;
}

.hud-pause-button .lipbox__face {
    flex-direction: row;
    border-width: 4px;
}

.hud-pause-bar {
    width: 15px;
    height: 44px;
    margin: 0 5px;
    border-radius: 4px;
    background-color: var(--ink);
}

/* ---- Boost button (bottom right). A pressable LipBox bent into a circle; height includes the 10 px lip. ---- */

.hud-boost {
    position: absolute;
    right: 140px;
    bottom: 102px;
    width: 186px;
    height: 196px;
}

.hud-boost .lipbox__face { border-radius: 93px; }
.hud-boost > .lipbox__lip { border-radius: 93px; }

.hud-boost-label {
    font-size: 42px;
    letter-spacing: 2px;
}

/* ---- Combo sticker (screen left). HudView drives scale / colours from the combo timer. ---- */

.hud-combo-sticker {
    display: none;
    position: absolute;
    left: 150px;
    top: 392px;
    padding-bottom: 12px;
    rotate: -8deg;
    transform-origin: left center;
}

/* LipBox: the lip is a backing element under the face (HudView tints the face as the combo timer drains). */
.hud-combo-sticker > .lipbox__lip {
    top: 12px;
    border-radius: 14px;
    background-color: rgba(16, 24, 35, 0.55);
}

.hud-combo-sticker > .lipbox__face {
    padding: 22px 40px 6px 40px;
    border-width: 6px;
    border-radius: 14px;
    border-color: var(--ink);
    background-color: var(--coral);
}

.hud-combo-label {
    font-size: 86px;
    color: rgb(255, 255, 255);
    text-shadow: 0 5px 0 rgba(0, 0, 0, 0.28);
    white-space: nowrap;
}

/* ---- Bounds warnings (states e, f, g) ---- */

.hud-fx {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-edge {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Ground proximity: red edge vignette + flashing PULL UP!. HudView toggles display and flashes the opacity. */
.hud-vignette-red {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-image: url("../../Art/Textures/UI/Tex_UiVignetteRed.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.hud-ground-text {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    font-size: 132px;
    letter-spacing: 4px;
    color: rgb(255, 255, 255);
    text-shadow: 0 8px 0 var(--coral-lip);
    -unity-text-align: middle-center;
    white-space: nowrap;
    rotate: -3deg;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

/* Hazard tape: baked stripes repeated at their natural size (same trick as the screen stripes). */
.hud-tape {
    background-color: var(--amber);
    background-image: url("../../Art/Textures/UI/Tex_UiHazardTape.png");
    background-repeat: repeat repeat;
    background-size: 108px 108px;
    background-position: left top;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.hud-tape.is-visible { translate: 0 0; }

.hud-tape-plate {
    padding: 16px 46px;
    border-radius: 14px;
    background-color: #1B2330;
    align-items: center;
}

.hud-tape-text {
    font-size: 60px;
    letter-spacing: 2px;
    color: var(--amber);
    white-space: nowrap;
}

.hud-ceiling-banner {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1300px;
    margin-left: -650px;
    padding: 22px 0 26px 0;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-width: 14px;
    border-bottom-color: rgba(16, 24, 35, 0.5);
    align-items: center;
    translate: 0 -320px;
}

.hud-ceiling-plate { flex-direction: row; }

.hud-ceiling-count {
    width: 84px;
    height: 84px;
    margin-left: 28px;
    border-radius: 42px;
    background-color: var(--coral);
    align-items: center;
    justify-content: center;
}

.hud-ceiling-count-label {
    font-size: 56px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* While the ceiling banner is down the fuel / health stack makes room under it. */
.hud-top-stack {
    transition-property: translate;
    transition-duration: 0.25s;
}

.hud-top-stack--shifted { translate: 0 168px; }

.hud-lateral-tape {
    position: absolute;
    top: 50%;
    width: 132px;
    height: 700px;
    margin-top: -350px;
    align-items: center;
    justify-content: center;
}

.hud-lateral-tape--right {
    right: 0;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
    border-left-width: 14px;
    border-left-color: rgba(16, 24, 35, 0.45);
    translate: 190px 0;
}

.hud-lateral-tape--left {
    left: 0;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-right-width: 14px;
    border-right-color: rgba(16, 24, 35, 0.45);
    translate: -190px 0;
}

/* The plate is laid out unrotated, so it gets a fixed size centred in the tape and is then rotated around its centre. */
.hud-lateral-plate {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 360px;
    height: 78px;
    margin-left: -180px;
    margin-top: -39px;
    padding: 0;
    justify-content: center;
}
.hud-lateral-tape--right .hud-lateral-plate { rotate: 90deg; }
.hud-lateral-tape--left .hud-lateral-plate { rotate: -90deg; }
.hud-lateral-text { font-size: 46px; }

/* ---- Resource states + damage (states d, h) ---- */

/* Low-resource halo: USS has no blur, so the glow is a translucent rounded plate behind the element plus a ring border. */
.hud-glow {
    display: none;
    position: absolute;
    border-radius: 36px;
}

.hud-fuel-glow {
    left: -30px;
    right: -30px;
    top: -22px;
    bottom: -20px;
    border-width: 5px;
    border-radius: 26px;
    border-color: rgba(240, 169, 59, 0.55);
    background-color: rgba(224, 69, 47, 0.16);
}

.hud-fuel-cluster--low .hud-glow { display: flex; }

.hud-fuel-cluster--low .hud-fuel-label {
    font-size: 30px;
    letter-spacing: 7px;
    color: var(--amber);
    transition-property: opacity;
    transition-duration: 0.5s;
}

.hud-health-glow {
    left: -18px;
    right: -18px;
    top: -14px;
    bottom: -14px;
    border-radius: 27px;
    background-color: rgba(224, 69, 47, 0.3);
}

.hud-health-wrap--low .hud-glow { display: flex; }

.hud-health-wrap--low .hud-health-bar {
    border-width: 4px;
    border-color: rgba(224, 69, 47, 0.5);
}

/* Damage overlay: fast fade in, slow fade out (the transition of the state being entered applies). */
.hud-damage-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.hud-damage-overlay.is-visible {
    opacity: 1;
    transition-duration: 0.08s;
}

.hud-damage-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/Textures/UI/Tex_UiVignetteDark.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-damage-cracks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../../Art/Textures/UI/Tex_UiCracks.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-hit-wrap {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 78%;
    align-items: center;
}

.hud-hit-sticker {
    padding-bottom: 10px;
    rotate: -4deg;
}

.hud-hit-sticker > .lipbox__lip {
    top: 10px;
    border-radius: 14px;
    background-color: rgba(16, 24, 35, 0.5);
}

.hud-hit-sticker > .lipbox__face {
    padding: 14px 36px 6px 36px;
    border-width: 5px;
    border-radius: 14px;
    border-color: var(--ink);
    background-color: var(--health-low);
}

.hud-hit-label {
    font-size: 54px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
}

/* ---- Impact popups (state c). HudImpactPopups drives scale / translate / opacity. The anchor is a zero-size box at the
   impact point; the fixed-width stack hangs from it (absolute edges, since centring inside a zero-size box is unreliable). ---- */

.hud-popups {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-popup {
    display: none;
    position: absolute;
    width: 0;
    height: 0;
}

.hud-popup__stack {
    position: absolute;
    left: -450px;
    width: 900px;
    bottom: -70px;
    align-items: center;
    rotate: -6deg;
}

.hud-popup__perfect {
    flex-shrink: 0;
    margin-bottom: -18px;
    font-size: 46px;
    color: var(--green);
    text-shadow: 0 4px 0 rgba(16, 24, 35, 0.6);
    white-space: nowrap;
}

.hud-popup__score {
    flex-shrink: 0;
    margin-bottom: -22px;
    font-size: 88px;
    color: var(--ink);
    text-shadow: 0 6px 0 rgba(16, 24, 35, 0.6);
    white-space: nowrap;
}

.hud-popup__coin-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.hud-popup__coin {
    flex-shrink: 0;
    font-size: 40px;
    color: var(--amber);
    text-shadow: 0 4px 0 rgba(16, 24, 35, 0.6);
    white-space: nowrap;
}

.hud-popup__coin-dot {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    margin-left: 10px;
    border-width: 6px;
    border-radius: 17px;
    border-color: var(--amber);
    background-color: var(--amber-light);
}

/* ---- Pause popup (S04) and 3-2-1 countdown. The popup layer / card base come from Theme.uss (.popup-layer, .popup). ---- */

.hud-pause-card { width: 1120px; }

.hud-pause-card > .lipbox__face { padding: 44px 54px 40px 54px; }

.hud-pause-head {
    flex-direction: row;
    align-items: flex-end;
    margin-top: -24px;
    margin-bottom: 14px;
}

.hud-pause-title {
    font-size: 82px;
    color: var(--ink);
    rotate: -2deg;
}

.hud-pause-mode {
    margin-left: 24px;
    margin-bottom: 18px;
    font-size: 28px;
    letter-spacing: 3px;
    color: rgba(246, 239, 226, 0.6);
}

.hud-pause-body {
    flex-direction: row;
}

.hud-pause-left {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 34px;
}

.hud-pause-right {
    width: 440px;
    flex-shrink: 0;
}

/* Theme gives .themed-slider flex-grow 1 (for row layouts); in this column it would stretch the sliders. */
.hud-pause-left .themed-slider {
    flex-grow: 0;
    flex-shrink: 0;
}

.hud-pause-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-pause-row--second { margin-top: 14px; }

.hud-pause-row-label {
    font-size: 28px;
    color: rgba(246, 239, 226, 0.78);
}

.hud-pause-row-value {
    font-size: 28px;
    color: var(--amber);
}

.hud-pause-switch-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
}

.hud-pause-hint {
    margin-top: 18px;
    font-size: 24px;
    color: var(--ink-55);
}

.hud-pause-resume {
    height: 130px;
    margin-bottom: 18px;
}

.hud-pause-resume .lipbox__label { font-size: 52px; }

.hud-pause-secondary {
    height: 98px;
    margin-bottom: 18px;
}

.hud-pause-secondary .lipbox__label {
    -unity-font-definition: url("../../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 34px;
}

.hud-pause-quit-note {
    padding: 16px 20px;
    border-radius: 16px;
    background-color: rgba(232, 96, 60, 0.14);
    font-size: 24px;
    color: rgb(255, 203, 185);
    white-space: normal;
}

.hud-countdown {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(10, 16, 24, 0.45);
    align-items: center;
    justify-content: center;
}

.hud-countdown-number {
    font-size: 260px;
    color: var(--ink);
    text-shadow: 0 12px 0 var(--coral);
}

.hud-countdown-text {
    margin-top: -56px;
    font-size: 34px;
    letter-spacing: 5px;
    color: rgba(246, 239, 226, 0.72);
}
