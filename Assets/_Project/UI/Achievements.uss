/* Achievements screen (Player profile & run stats Pass 6d). Header and fonts come from Theme/Theme.uss; this file lays out
   the vertical list of badge rows. Flow layout inside the menu's safe-area padding. */

.achievements-screen {
    flex-grow: 1;
    padding: 16px 24px 24px 24px;
}

.achievements-count {
    margin-left: 28px;
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 32px;
    letter-spacing: 5px;
    color: var(--amber);
}

.achievements-pick {
    height: 94px;
    min-width: 200px;
    margin-right: 8px;
}

.achievements-pick > .lipbox__face {
    padding: 0 40px;
    border-radius: 18px;
}

.achievements-pick > .lipbox__lip { border-radius: 18px; }

.achievements-pick .lipbox__label {
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 32px;
}

.achievements-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    margin-top: 16px;
}

/* Thin, quiet scroller: the list also scrolls by wheel and drag. */
.achievements-scroll .unity-scroller--vertical {
    width: 12px;
    margin-left: 10px;
}

.achievements-scroll .unity-repeat-button { display: none; }

.achievements-scroll .unity-base-slider--vertical { margin: 0; }

.achievements-scroll .unity-base-slider__tracker {
    width: 12px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(16, 24, 35, 0.4);
}

.achievements-scroll .unity-base-slider__dragger {
    width: 12px;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--ink-35);
}

/* ---- Rows: name heading, description under it, the three tier pips on the right ---- */

.ach-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 112px;
    margin-bottom: 12px;
    padding: 14px 32px;
    border-width: 3px;
    border-radius: 26px;
    border-color: var(--border-soft);
    background-color: var(--panel);
}

.ach-row.is-pressed { background-color: var(--panel-inner); }

.ach-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin-right: 24px;
}

.ach-row__name {
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 42px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ach-row__desc {
    -unity-font-definition: url("../Art/Fonts/Nunito-SemiBold.ttf");
    font-size: 28px;
    color: var(--ink-70);
    white-space: normal;
}

/* A badge with no tier yet: dimmed, empty pips. */
.ach-row--locked { background-color: var(--panel-inner); }
.ach-row--locked .ach-row__name,
.ach-row--locked .ach-row__desc { opacity: 0.55; }

/* An earned hidden badge: gold outline and a gold name, drawn first. */
.ach-row--hidden {
    border-width: 5px;
    border-color: var(--gold);
}

.ach-row--hidden .ach-row__name { color: var(--gold); }

.ach-row__pips {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ach-pip {
    width: 36px;
    height: 36px;
    margin-left: 14px;
    border-radius: 18px;
    border-width: 4px;
    border-color: var(--ink-35);
}

.ach-pip--bronze { background-color: var(--bronze); border-color: var(--bronze-lip); }
.ach-pip--silver { background-color: var(--silver); border-color: var(--silver-lip); }
.ach-pip--gold { background-color: var(--gold); border-color: var(--gold-lip); }

/* The "new" pip on an earned hidden badge the player has not opened yet. */
.ach-row__new {
    width: 26px;
    height: 26px;
    margin-right: 16px;
    border-radius: 13px;
    border-width: 4px;
    border-color: var(--ink);
    background-color: var(--coral);
}

/* ---- Pick mode: a checkbox on every row that can be picked; at the limit the unticked rows grey out ---- */

.ach-check {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-right: 28px;
    border-width: 4px;
    border-radius: 12px;
    border-color: var(--ink-55);
    align-items: center;
    justify-content: center;
}

.ach-check--on {
    border-color: var(--amber);
    background-color: var(--amber);
}

/* The tick is a rotated corner, so no glyph is needed. */
.ach-check__mark {
    display: none;
    width: 14px;
    height: 26px;
    margin-bottom: 4px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-right-color: var(--ink-dark);
    border-bottom-color: var(--ink-dark);
    rotate: 45deg;
}

.ach-check--on .ach-check__mark { display: flex; }

.ach-row--off { opacity: 0.45; }
