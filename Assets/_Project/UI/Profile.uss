/* Profile screen (UI/art pass, Pass 6c). Cards, header and tabs come from Theme/Theme.uss; this file lays out the two
   columns, the stat tiles, the name field and the badge row. Flow layout inside the menu's safe-area padding. */

.profile-screen {
    flex-grow: 1;
    padding: 16px 24px 24px 24px;
}

.profile-columns {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 14px;
}

.profile-left {
    width: 640px;
    flex-shrink: 0;
    margin-right: 32px;
}

.profile-right {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.profile-row {
    flex-direction: row;
    flex-shrink: 0;
}

/* ---- Header: SHARE (top right, same size as the leaderboard's SHARE MY RANK) ---- */

.profile-share {
    height: 94px;
    margin-right: 8px;
}

.profile-share > .lipbox__face {
    padding: 0 40px;
    border-radius: 18px;
}

.profile-share > .lipbox__lip { border-radius: 18px; }

.profile-share .lipbox__label {
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 32px;
}

/* ---- Shared small labels ---- */

.profile-label {
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 26px;
    letter-spacing: 4px;
    color: var(--ink-55);
}

.profile-label--big {
    font-size: 28px;
    letter-spacing: 5px;
}

/* ---- Portrait slot ---- */

.profile-portrait { flex-grow: 1; margin-bottom: 22px; }

.profile-portrait.card > .lipbox__face {
    align-items: center;
    justify-content: center;
}

.profile-portrait__slot {
    width: 420px;
    height: 300px;
    border-width: 4px;
    border-radius: 20px;
    border-color: rgba(246, 239, 226, 0.4);
    background-color: rgba(246, 239, 226, 0.06);
}

.profile-portrait__caption {
    margin-top: 16px;
    white-space: normal;
    -unity-font-definition: url("../Art/Fonts/Nunito-SemiBold.ttf");
    font-size: 24px;
    color: var(--ink-70);
    -unity-text-align: middle-center;
}

/* ---- Display name card ---- */

.profile-name-card { flex-shrink: 0; margin-bottom: 12px; }

.profile-name-card.card > .lipbox__face { padding: 26px 30px; }

.profile-name-field {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 12px 14px 12px 24px;
    border-width: 3px;
    border-radius: 18px;
    border-color: rgba(240, 169, 59, 0.5);
    background-color: var(--panel-inner);
}

.profile-name-label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 44px;
    color: var(--ink);
}

.profile-name-input {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.profile-name-input .unity-base-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 44px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

.profile-icon-button {
    width: 80px;
    height: 80px;
    margin-left: 12px;
    flex-shrink: 0;
}

.profile-icon-button > .lipbox__face { border-radius: 16px; }

.profile-icon-button > .lipbox__lip { border-radius: 16px; }

.profile-icon {
    width: 38px;
    height: 38px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink-dark);
}

.profile-icon--pencil { background-image: url("../Art/Textures/UI/Tex_UiPencil.png"); }

.profile-icon--dice {
    background-image: url("../Art/Textures/UI/Tex_UiDice.png");
    -unity-background-image-tint-color: var(--ink);
}

.profile-icon--check { background-image: url("../Art/Textures/UI/Tex_UiCheck.png"); }

.profile-id-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
}

.profile-id {
    flex-shrink: 1;
    white-space: normal;
    -unity-font-definition: url("../Art/Fonts/Nunito-SemiBold.ttf");
    font-size: 24px;
    color: var(--ink-55);
}

.profile-coin-chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 16px;
    padding: 8px 20px;
    border-width: 3px;
    border-radius: 16px;
    border-color: rgba(240, 169, 59, 0.45);
    background-color: rgba(240, 169, 59, 0.16);
}

.profile-coin {
    width: 30px;
    height: 30px;
    margin-right: 12px;
    border-radius: 15px;
    background-color: var(--amber-light);
}

.profile-coin-value {
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 32px;
    color: var(--amber);
}

/* ---- Stat tiles ---- */

.stat-tile {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 20px;
    margin-bottom: 6px;
}

.stat-tile--first { margin-left: 0; }

.stat-tile.card > .lipbox__face { padding: 16px 28px 8px 28px; }

.stat-tile__label {
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 26px;
    letter-spacing: 3px;
    color: var(--ink-55);
}

.stat-tile__value {
    height: 70px;
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 72px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

/* The best-run tile reads as the hero: amber tint and outline. */
.stat-tile--hero.card > .lipbox__face {
    border-color: rgba(240, 169, 59, 0.5);
    background-color: rgba(240, 169, 59, 0.16);
}

.stat-tile--hero.card > .lipbox__lip { background-color: rgba(16, 24, 35, 0.6); }

.stat-tile--hero .stat-tile__label { color: rgba(240, 169, 59, 0.95); }

/* ---- Equipped plane / crash FX ---- */

.profile-equip {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 20px;
    margin-bottom: 6px;
}

.profile-equip--first { margin-left: 0; }

.profile-equip.card > .lipbox__face {
    flex-direction: row;
    align-items: center;
    padding: 8px 28px;
}

/* The thumbnail slot stays empty and transparent for the 3D half (equipped plane / crash FX render). */
.profile-thumb {
    width: 88px;
    height: 88px;
    margin-right: 20px;
    flex-shrink: 0;
    border-width: 4px;
    border-radius: 18px;
    border-color: rgba(246, 239, 226, 0.4);
    background-color: rgba(246, 239, 226, 0.06);
}

.profile-equip__text {
    flex-shrink: 1;
    flex-grow: 1;
}

.profile-equip__name {
    margin-top: -2px;
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 42px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---- Badges ---- */

.profile-badges {
    flex-grow: 1;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.profile-badges.card > .lipbox__face { padding: 14px 30px 10px 30px; }

.profile-badges__title {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.profile-badge-count {
    margin-left: 14px;
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 28px;
    letter-spacing: 5px;
    color: var(--amber);
}

.profile-badge-scroll {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 12px;
}

.profile-badge-scroll .unity-scroller--horizontal {
    height: 12px;
    margin-top: 8px;
}

.profile-badge-scroll .unity-repeat-button { display: none; }

.profile-badge-scroll .unity-base-slider--horizontal { margin: 0; }

.profile-badge-scroll .unity-base-slider__tracker {
    height: 12px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(16, 24, 35, 0.4);
}

.profile-badge-scroll .unity-base-slider__dragger {
    height: 12px;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--ink-35);
}

.badge {
    width: 128px;
    height: 128px;
    margin-right: 14px;
    flex-shrink: 0;
}

.badge > .lipbox__face {
    border-width: 0;
    border-radius: 26px;
    align-items: center;
    justify-content: center;
}

.badge > .lipbox__lip { border-radius: 26px; }

.badge.lipbox--primary > .lipbox__lip { background-color: var(--amber-lip); }

.badge__label {
    -unity-font-definition: url("../Art/Fonts/Nunito-ExtraBold.ttf");
    font-size: 24px;
    color: var(--ink-dark);
    white-space: normal;
    -unity-text-align: middle-center;
}

.badge--locked > .lipbox__face {
    border-width: 4px;
    border-color: rgba(246, 239, 226, 0.3);
    background-color: var(--panel-inner);
}

.badge--locked .badge__label {
    -unity-font-definition: url("../Art/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 44px;
    color: rgba(246, 239, 226, 0.4);
}

.badge.is-selected > .lipbox__face {
    border-width: 4px;
    border-color: var(--ink);
}

.profile-badge-caption {
    flex-shrink: 0;
    margin-top: 8px;
    white-space: normal;
    -unity-font-definition: url("../Art/Fonts/Nunito-SemiBold.ttf");
    font-size: 26px;
    color: var(--ink-70);
}
